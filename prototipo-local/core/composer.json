{
  "name": "demo/plataforma-lojas",
  "type": "project",
  "description": "Protótipo local multi-tenant para demonstração da plataforma.",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "3.7.0",
    "laravel/framework": "13.42.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/" }
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": { "php-http/discovery": true }
  }
}
